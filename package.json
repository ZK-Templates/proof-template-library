{
  "name": "proof-template-library",
  "version": "0.3.0",
  "description": "Reusable ZK templates and Proof Passport infrastructure for autonomous agents.",
  "type": "module",
  "bin": {
    "proof-templates": "./src/cli.js"
  },
  "scripts": {
    "build:circuit": "node scripts/compile-testnet-circuit.js",
    "build:verifier": "npm run build:circuit && node scripts/generate-testnet-verifier.js",
    "build:site": "node scripts/build-site.js",
    "proof:testnet": "npm run build:circuit && node scripts/run-testnet-proof.js",
    "test": "node --test tests/*.test.mjs",
    "list": "node src/cli.js list"
  },
  "keywords": [
    "zero-knowledge",
    "zk",
    "proofs",
    "circuits",
    "noir",
    "circom"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aztec/bb.js": "^5.2.1",
    "@noir-lang/noir_js": "^1.0.0-rc.5",
    "@noir-lang/noir_wasm": "^1.0.0-rc.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.11"
  }
}
